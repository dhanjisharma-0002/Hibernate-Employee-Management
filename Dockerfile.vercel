# ==============================================================================
# Vercel-compatible OCI Container Configuration for Tomcat 10.1 + Java 17 WAR
# Documentation: https://vercel.com/docs/functions/runtimes/container-runtimes
# ==============================================================================

# Stage 1: Build the Maven WAR artifact
FROM maven:3.9-eclipse-temurin-17-alpine AS builder
WORKDIR /app

# Copy pom.xml and source code
COPY pom.xml .
COPY src ./src

# Build production WAR (skipping test suite for clean fast container build)
RUN mvn clean package -DskipTests -B

# Stage 2: Production Runtime with Apache Tomcat 10.1 on Eclipse Temurin JDK 17
FROM tomcat:10.1-jdk17-temurin-jammy
WORKDIR /usr/local/tomcat

# Remove default boilerplate Tomcat webapps (docs, examples, ROOT, manager)
RUN rm -rf webapps/*

# Deploy the application as ROOT.war so it serves directly at root path /
COPY --from=builder /app/target/HibernateEmployeeManagement.war webapps/ROOT.war

# Vercel Container Runtime routes HTTP traffic to $PORT (defaults to 80)
EXPOSE 80

# Self-contained startup: dynamically replaces port 8080 with $PORT (or 80) in server.xml
CMD ["sh", "-c", "sed -i \"s/port=\\\"8080\\\"/port=\\\"${PORT:-80}\\\"/g\" /usr/local/tomcat/conf/server.xml && exec catalina.sh run"]
